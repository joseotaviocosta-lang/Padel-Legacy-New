{
  "name": "Partnership",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "ID do PlayerProfile; ausente em duplas NPC x NPC"
    },
    "partnership_type": { "type": "string", "enum": ["player", "npc"], "default": "player" },
    "scope": { "type": "string", "enum": ["career", "world"], "default": "career" },
    "athlete_a_id": { "type": "string" },
    "athlete_b_id": { "type": "string" },
    "athlete_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
    "athlete_a_name": { "type": "string" },
    "athlete_b_name": { "type": "string" },
    "partner_bot_id": {
      "type": "string",
      "description": "ID do bot/athlete parceiro"
    },
    "partner_name": {
      "type": "string",
      "description": "Nome do parceiro (denormalizado)"
    },
    "partner_country": {
      "type": "string"
    },
    "partner_level": {
      "type": "string",
      "description": "N\u00edvel do parceiro quando a parceria iniciou"
    },
    "partner_position": {
      "type": "string",
      "enum": [
        "direita",
        "esquerda"
      ]
    },
    "partner_play_style": {
      "type": "string"
    },
    "partner_overall": {
      "type": "number",
      "description": "Overall do parceiro na \u00e9poca"
    },
    "started_career_date": {
      "type": "string",
      "format": "date",
      "description": "Data no jogo quando a parceria come\u00e7ou"
    },
    "negotiated_duration_days": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o negociada em dias"
    },
    "scheduled_end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de fim contratual"
    },
    "contract_started_date": { "type": "string", "format": "date" },
    "contract_end_date": { "type": "string", "format": "date" },
    "contract_status": { "type": "string", "enum": ["ativo", "renovacao_proxima", "negociacao", "renovado", "vencido", "nao_renovara", "encerrar_ao_final", "encerrado", "insatisfeito"], "default": "ativo" },
    "renewal_available": { "type": "boolean", "default": false },
    "renewal_count": { "type": "number", "default": 0 },
    "renewal_interest_snapshot": { "type": "object" },
    "last_renewal_decision_key": { "type": "string" },
    "last_renewal_decision": { "type": "object" },
    "partner_market_offer": { "type": "object" },
    "last_partner_market_month": { "type": "string" },
    "origin": { "type": "string" },
    "history": { "type": "array", "items": { "type": "object" }, "default": [] },
    "schema_version": { "type": "number", "default": 2 },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "encerrada_amigavel",
        "encerrada_jogador",
        "encerrada_parceiro",
        "expirada",
        "recusada"
      ],
      "default": "ativa",
      "description": "Estado da parceria"
    },
    "prize_split_pct": {
      "type": "number",
      "default": 50,
      "description": "Percentual da premia\u00e7\u00e3o que fica com o jogador (0-100)"
    },
    "chemistry": {
      "type": "number",
      "default": 50,
      "description": "Entrosamento atual (0-100)"
    },
    "shared_matches": {
      "type": "number",
      "default": 0
    },
    "shared_wins": {
      "type": "number",
      "default": 0
    },
    "shared_losses": {
      "type": "number",
      "default": 0
    },
    "shared_tournaments": {
      "type": "number",
      "default": 0
    },
    "shared_titles": {
      "type": "number",
      "default": 0
    },
    "shared_goals": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Objetivos compartilhados: [{id, title, target, progress, completed}]"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Conflitos registrados: [{date, title, description, severity, resolved}]"
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Conversas: [{date, speaker, text, tone}]"
    },
    "chemistry_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Hist\u00f3rico de entrosamento: [{date, chemistry, event}]"
    },
    "end_reason": {
      "type": "string",
      "description": "Motivo do encerramento"
    },
    "ended_career_date": {
      "type": "string",
      "format": "date"
    },
    "compatibility_score": {
      "type": "number",
      "default": 50,
      "description": "Compatibilidade inicial calculada (0-100)"
    },
    "compatibility_breakdown": {
      "type": "object",
      "description": "Detalhamento: {position, style, personality, level, schedule}"
    }
  },
  "required": [
    "partner_name"
  ]
}
