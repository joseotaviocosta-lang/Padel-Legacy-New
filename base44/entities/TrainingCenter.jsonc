{
  "name": "TrainingCenter",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "ID do PlayerProfile"
    },
    "name": {
      "type": "string",
      "description": "Nome do centro de treinamento"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "N\u00edvel geral do centro"
    },
    "facilities": {
      "type": "object",
      "description": "N\u00edveis de cada instala\u00e7\u00e3o: {courts, gym, physio, medical, performance_analysis, biomechanics, nutrition, psychology, accommodation, laboratory, vip}"
    },
    "total_invested": {
      "type": "number",
      "default": 0,
      "description": "Total investido em moedas"
    },
    "reputation_bonus": {
      "type": "number",
      "default": 0,
      "description": "B\u00f4nus de reputa\u00e7\u00e3o do centro"
    }
  },
  "required": [
    "profile_id"
  ]
}