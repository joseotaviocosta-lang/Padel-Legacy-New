{
  "name": "MissionProgress",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "description": "ID da miss\u00e3o"
    },
    "profile_id": {
      "type": "string",
      "description": "ID do jogador"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Progresso atual"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Se o objetivo foi atingido"
    },
    "claimed": {
      "type": "boolean",
      "default": false,
      "description": "Se as recompensas j\u00e1 foram resgatadas"
    },
    "reward_delivered": {
      "type": "boolean",
      "default": false,
      "description": "Trava persistida de entrega idempotente da recompensa"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante da primeira conclus\u00e3o"
    },
    "completion_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Instante em que a conclus\u00e3o foi notificada"
    }
  },
  "required": [
    "mission_id",
    "profile_id"
  ]
}
