{
  "name": "Season",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da temporada"
    },
    "description": {
      "type": "string",
      "description": "Tema/descri\u00e7\u00e3o"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Se a temporada est\u00e1 ativa"
    },
    "season_number": {
      "type": "number",
      "description": "N\u00famero da temporada"
    }
  },
  "required": [
    "name"
  ]
}