{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "description": "Nome do autor"
    },
    "author_handle": {
      "type": "string",
      "description": "@handle do autor"
    },
    "author_avatar": {
      "type": "string"
    },
    "author_level": {
      "type": "string"
    },
    "author_type": {
      "type": "string",
      "enum": [
        "jogador",
        "atleta",
        "clube",
        "patrocinador",
        "treinador",
        "torcedor"
      ],
      "default": "torcedor",
      "description": "Tipo de autor"
    },
    "author_verified": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "string",
      "description": "Texto da publica\u00e7\u00e3o"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "resultado",
        "conquista",
        "geral",
        "torneio",
        "critica",
        "elogio",
        "rumor",
        "tendencia",
        "motivacional"
      ],
      "default": "geral",
      "description": "Tipo de publica\u00e7\u00e3o"
    },
    "image_url": {
      "type": "string",
      "description": "Imagem anexada (opcional)"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "shares": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Coment\u00e1rios: [{author_name, author_type, author_handle, content, created_date, likes}]"
    },
    "is_viral": {
      "type": "boolean",
      "default": false
    },
    "trend_tag": {
      "type": "string",
      "description": "Hashtag de tend\u00eancia"
    },
    "follower_gain": {
      "type": "number",
      "default": 0,
      "description": "Seguidores ganhos pelo jogador neste post"
    },
    "profile_id": {
      "type": "string",
      "description": "ID do PlayerProfile (se for post do jogador)"
    },
    "career_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "author_name",
    "content"
  ]
}