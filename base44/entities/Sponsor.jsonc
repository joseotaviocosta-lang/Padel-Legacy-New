{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do patrocinador"
    },
    "tier": {
      "type": "string",
      "enum": [
        "Ouro",
        "Prata",
        "Bronze"
      ],
      "description": "N\u00edvel do patrocinador"
    },
    "industry": {
      "type": "string",
      "description": "Setor da ind\u00fastria"
    },
    "country": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_emoji": {
      "type": "string",
      "description": "Emoji representando a marca"
    },
    "reputation": {
      "type": "number",
      "default": 50,
      "description": "Reputa\u00e7\u00e3o da marca (0-100)"
    },
    "monthly_budget": {
      "type": "number",
      "default": 5000,
      "description": "Or\u00e7amento mensal dispon\u00edvel para patroc\u00ednios"
    },
    "base_monthly_value": {
      "type": "number",
      "default": 0,
      "description": "Valor base mensal oferecido"
    },
    "base_sign_bonus": {
      "type": "number",
      "default": 0,
      "description": "B\u00f4nus de assinatura base"
    },
    "preferred_styles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Estilos de jogo preferidos: [Agressivo, Defensivo, Equilibrado, T\u00e1tico, Pot\u00eancia]"
    },
    "preferred_levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "N\u00edveis de jogador preferidos: [Iniciante, Amador, Competitivo, Avan\u00e7ado, Elite, Lenda]"
    },
    "preferred_positions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Posi\u00e7\u00f5es preferidas: [direita, esquerda]"
    },
    "min_age": {
      "type": "number",
      "default": 16,
      "description": "Idade m\u00ednima do atleta"
    },
    "max_age": {
      "type": "number",
      "default": 40,
      "description": "Idade m\u00e1xima do atleta"
    },
    "min_xp": {
      "type": "number",
      "default": 0,
      "description": "XP m\u00ednimo exigido"
    },
    "min_titles": {
      "type": "number",
      "default": 0,
      "description": "T\u00edtulos m\u00ednimos exigidos"
    },
    "min_fan_appeal": {
      "type": "number",
      "default": 0,
      "description": "Apego dos f\u00e3s m\u00ednimo (0-100)"
    },
    "marketing_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Exig\u00eancias: [social_posts, interviews, events, photo_shoots, equipment_usage, logo_visibility]"
    },
    "commercial_goals": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Metas comerciais: [{type, target, period, reward_penalty}]"
    },
    "performance_clauses": {
      "type": "object",
      "description": "Cl\u00e1usulas de desempenho: {min_ranking, min_win_rate, tournament_participation, termination_threshold}"
    },
    "contract_duration_months": {
      "type": "number",
      "default": 6,
      "description": "Dura\u00e7\u00e3o padr\u00e3o do contrato em meses"
    },
    "renewal_bonus_pct": {
      "type": "number",
      "default": 10,
      "description": "B\u00f4nus percentual na renova\u00e7\u00e3o"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Se aceita novos contratos"
    }
  },
  "required": [
    "name"
  ]
}